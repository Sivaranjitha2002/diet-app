PORT=3001
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-here
DB_CONNECTION_STRING=your-database-connection-string

# Email Configuration (using Gmail as example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Twilio Configuration for SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# AI Service Configuration (OpenAI example)
# Set up at least one of the following API keys for AI recommendations

# OpenAI (Recommended - most reliable and feature-rich)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Alternative - fast and cost-effective)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Alternative - Google's AI model)
GEMINI_API_KEY=your_gemini_api_key_here

# Catalyst Zia Configuration (if using Catalyst Zia SDK)
# These will be automatically configured if running in Catalyst environment
# ZIA_API_KEY=your_zia_api_key_here
# ZIA_ORG_ID=your_zia_org_id_here